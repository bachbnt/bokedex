    "vueuse", "VueUse", "tilt", "jsdelivr", "Bricolage", "Instrument", "Charizard", "Blastoise", "Venusaur",
    "Eevee", "Gengar", "Dragonite", "Pikachu", "WCAG", "webp"
  ]
}
