{
  "name": "bokedex",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Bokedex — a fast, animated Pokédex and game companion built with Nuxt.",
  "scripts": {
    "dev": "nuxt dev",
    "predev": "npm run ingest",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "pregenerate": "npm run ingest",
    "preview": "firebase emulators:start --only hosting",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "tsx --tsconfig scripts/tsconfig.json scripts/ingest/index.ts",
    "deploy:firebase": "npm run generate && firebase deploy --only hosting"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.11.4",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^0.11.2",
    "@tailwindcss/vite": "^4.1.11",
    "@vueuse/core": "^13.5.0",
    "@vueuse/nuxt": "^13.5.0",
    "nuxt": "^4.6.4",
    "pinia": "^3.0.3",
    "tailwindcss": "^4.1.11",
    "vue": "^3.5.18",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.0.4"
  }
}
